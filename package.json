{
  "name": "northbound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5190",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:vercel": "convex deploy --cmd \"npm run build\" --cmd-url-env-var-name VITE_CONVEX_URL"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@supabase/supabase-js": "^2.119.0",
    "convex": "^1.49.0",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
